# ─────────────────────────────────────────────────────────────────────────────
# CourseLens Backend — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env in the courselens/backend/ directory and fill in
# the values. Never commit .env to version control.
#
# Find Supabase values in the Supabase dashboard:
#   Project Settings → API
# ─────────────────────────────────────────────────────────────────────────────

# The public URL of your Supabase project.
# Used by the supabase-py client to reach the PostgREST / Auth / Storage APIs.
SUPABASE_URL=https://ypeyjbjazqosogluefvc.supabase.co

# The service role (secret) key for your Supabase project.
# This key bypasses Row Level Security — keep it server-side only and never
# expose it to the browser or commit it to version control.
SUPABASE_SERVICE_KEY=
